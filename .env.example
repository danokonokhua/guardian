# ============================================================
# Guardian — environment configuration template
# ============================================================
# Copy to `.env` for local development and Docker Compose:
#   cp .env.example .env
#
# NEVER commit real credentials. All `.env*` files are gitignored;
# `.env.example` is the only tracked template.
#
# Scope:
#   [public]  browser-safe (NEXT_PUBLIC_* prefix) — never contains secrets
#   [server]  server-only — must NEVER be imported into client code
#
# Status:
#   [active]   read and validated by the configuration layer today
#   [reserved] validated when present; consumed by a future phase
#
# All variables are read exclusively through config/env.ts (core),
# config/public.ts (browser-safe subset), and config/server.ts
# (server-only aggregate).
# ============================================================

# --- Application runtime ---------------------------------------------

# LOG_LEVEL [server][active]
#   Minimum severity for the structured logger.
#   Values: debug | info | warn | error. Default: info
LOG_LEVEL=info

# TRUSTED_PROXY [server][active]
#   Set true only when a reverse proxy strips and rewrites X-Forwarded-For /
#   X-Real-IP before forwarding requests and sends the matching internal token.
TRUSTED_PROXY=false
# TRUSTED_PROXY_TOKEN=<long random value shared only with the reverse proxy>

# APP_ENV [server][active]
#   Deployment label attached to logs and health output
#   (local | development | staging | production). Default: NODE_ENV.
# APP_ENV=local

# --- Public / browser-safe ------------------------------------------

# NEXT_PUBLIC_APP_URL [public][active]
#   Canonical application URL. Optional in development/test;
#   REQUIRED in production (surfaced as a configuration issue
#   when missing). Never contains a secret.
#   Example: https://guardian.example.com
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# GUARDIAN_WEB_PORT=3000
#   Host port for the web container (use another local port when running a
#   parallel smoke stack; the container always listens on 3000).

# --- Server-only / reserved -----------------------------------------

# POSTGRES_USER [server][active, Compose admin]
#   PostgreSQL owner used only by the migration service and role bootstrap.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=replace-with-a-long-random-admin-password
# POSTGRES_DB=guardian

# POSTGRES_APP_USER [server][active, Compose runtime]
#   Least-privilege PostgreSQL role used by web, worker, and bootstrap.
# POSTGRES_APP_USER=guardian_app
# POSTGRES_APP_PASSWORD=replace-with-a-different-long-random-runtime-password

# DATABASE_URL [server][active]
#   PostgreSQL connection string used by the application at runtime.
#   Compose derives this from POSTGRES_APP_USER/POSTGRES_APP_PASSWORD.
# DATABASE_URL=

# DIRECT_URL [server][active]
#   Direct PostgreSQL connection string used only by Prisma migrations.
# DIRECT_URL=

# SENTRY_DSN [server][active]
#   Sentry ingestion DSN for server-side error capture (observability
#   foundation). OPTIONAL — when unset, Sentry stays completely disabled and
#   local development is unaffected. Format: https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_DSN=

# Phase 1B-09 (jobs): CRON_SECRET= # [server-only] guards POST /api/cron/tick

# REPORTING_WEBHOOK_URL [server][active]
#   Optional HTTPS/HTTP destination for signed analytics reports.
# REPORTING_WEBHOOK_URL=

# REPORTING_WEBHOOK_SECRET [server][active]
#   Secret used for the x-guardian-signature HMAC header. Store only in a
#   deployment secret manager; never commit a real value.
# REPORTING_WEBHOOK_SECRET=

# --- Operational email delivery ------------------------------------

# SMTP_HOST=live.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=<provider username>
# SMTP_PASSWORD=<provider password or token>
# SMTP_SECURE=false
# MAIL_FROM_EMAIL=alerts@yourdomain.com
# MAIL_FROM_NAME=Guardian Alerts

# --- Self-hosted local authentication bootstrap --------------------
# Used only by `npm run auth:bootstrap` or the Docker `bootstrap` service.
# The password is hashed before storage; never commit these values.
# GUARDIAN_ADMIN_EMAIL=owner@example.com
# GUARDIAN_ADMIN_PASSWORD=replace-with-long-password
# GUARDIAN_ADMIN_NAME=Guardian Owner
# GUARDIAN_ORGANIZATION_NAME=Guardian Organization
