{
  "name": "guardian",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Business Guardian — AI-powered digital business operations platform (foundation phase).",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --require ./scripts/server-only-cli.cjs ./node_modules/tsx/dist/cli.mjs scripts/start-web.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema db/schema.prisma",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate dev --schema db/schema.prisma",
    "db:deploy": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate deploy --schema db/schema.prisma",
    "jobs:deploy": "node ./node_modules/pg-boss/dist/cli.js migrate --schema guardian_jobs",
    "db:status": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate status --schema db/schema.prisma",
    "auth:bootstrap": "node --require ./scripts/server-only-cli.cjs ./node_modules/tsx/dist/cli.mjs scripts/bootstrap-admin.ts",
    "audit:validate": "node --require ./scripts/server-only-cli.cjs ./node_modules/tsx/dist/cli.mjs scripts/free-audit-validation.ts",
    "postinstall": "prisma generate --schema db/schema.prisma",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker": "node --require ./scripts/server-only-cli.cjs ./node_modules/tsx/dist/cli.mjs scripts/worker.ts",
    "reporting:smoke": "node --require ./scripts/server-only-cli.cjs ./node_modules/tsx/dist/cli.mjs scripts/reporting-smoke.ts",
    "test:integration": "vitest run tests/db/rls.integration.test.ts tests/jobs/system-ping.integration.test.ts tests/jobs/monitor-check.integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "@sentry/node": "10.71.0",
    "next": "16.3.2",
    "nodemailer": "9.0.6",
    "pg-boss": "12.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "prisma": "6.19.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@prisma/client@6.19.2": true,
    "@prisma/engines@6.19.2": true,
    "prisma@6.19.2": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
