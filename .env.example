# ============================================================
# Guardian — environment configuration template
# ============================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# NEVER commit real credentials. All `.env*` files are gitignored;
# `.env.example` is the only tracked exception.
#
# All variables are read EXCLUSIVELY by `config/env.ts`.
# Only declare a variable when code that consumes it exists
# (dependency and configuration discipline).
# ============================================================

# ------------------------------------------------------------
# Application runtime — active in Phase 1B-01
# ------------------------------------------------------------

# LOG_LEVEL
#   Purpose:  minimum severity emitted by the structured logger
#   Values:   debug | info | warn | error
#   Required: no (default: info)
LOG_LEVEL=info

# APP_ENV
#   Purpose:  deployment label attached to logs and health output
#             (local | development | staging | production)
#   Required: no (default: value of NODE_ENV)
# APP_ENV=local

# ------------------------------------------------------------
# Reserved for LATER PHASES — NOT read by the application yet.
# Listed so local environments can be prepared in advance and the
# configuration surface stays visible to developers.
# ------------------------------------------------------------

# DATABASE_URL — Phase 1B-03/1B-04 (PostgreSQL + Prisma)
#   Purpose:  PostgreSQL connection string
#   Required: when the database layer lands
#   Example:  postgresql://guardian:password@localhost:5432/guardian
# DATABASE_URL=

# Supabase — Phase 1B-05 (authentication via Supabase Auth)
#   Purpose: Supabase project URL and API keys
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Email — later phase (transactional notifications)
#   Purpose: outbound email provider key
# RESEND_API_KEY=

# AI providers — later phase (advisory AI layer)
#   Purpose: provider API keys behind the AI abstraction
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Payments — later phase (billing abstraction)
# PAYSTACK_SECRET_KEY=
# STRIPE_SECRET_KEY=
