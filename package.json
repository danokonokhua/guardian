{
  "name": "guardian",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Business Guardian — AI-powered digital business operations platform (foundation phase).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema db/schema.prisma",
    "db:migrate": "prisma migrate dev --schema db/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema db/schema.prisma",
    "db:status": "prisma migrate status --schema db/schema.prisma",
    "postinstall": "prisma generate --schema db/schema.prisma",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker": "tsx scripts/worker.ts",
    "test:integration": "vitest run tests/db/rls.integration.test.ts tests/jobs/system-ping.integration.test.ts tests/jobs/monitor-check.integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "@sentry/node": "10.71.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "next": "16.3.2",
    "pg-boss": "12.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "prisma": "6.19.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@prisma/client@6.19.2": true,
    "@prisma/engines@6.19.2": true,
    "prisma@6.19.2": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
